import Trefoil.LatticeEmbedding
import Mathlib.Algebra.BigOperators.Pi
import Mathlib.LinearAlgebra.Finsupp.LinearCombination

/-!
# The modulo-two span of the norm-two paths

These lemmas derive the block-parity criterion used in Section 3A.  Zero
coordinate sum is characterized by an actual linear span of the adjacent
differences; it is not inserted as an independence assumption.
-/

namespace Trefoil.LatticeParity

open scoped BigOperators

abbrev F₂ := ZMod 2

/-- The standard basis vector at a finite coordinate. -/
def delta {n : ℕ} (i : Fin n) : Fin n → F₂ := Pi.single i 1

/-- An adjacent difference on a path with `n+1` vertices. -/
def pathRoot (n : ℕ) (i : Fin n) : Fin (n+1) → F₂ :=
  delta i.castSucc - delta i.succ

def pathSpan (n : ℕ) : Submodule F₂ (Fin (n+1) → F₂) :=
  Submodule.span F₂ (Set.range (pathRoot n))

theorem delta_sub_first_mem (n : ℕ) (i : Fin (n+1)) :
    delta i - delta 0 ∈ pathSpan n := by
  induction i using Fin.induction with
  | zero => simp
  | succ i ih =>
      have hr : pathRoot n i ∈ pathSpan n := Submodule.subset_span ⟨i, rfl⟩
      have h := (pathSpan n).sub_mem ih hr
      convert h using 1
      simp [pathRoot]

theorem zero_sum_mem_pathSpan (n : ℕ) (x : Fin (n+1) → F₂)
    (hx : ∑ i, x i = 0) : x ∈ pathSpan n := by
  have hmem : (∑ i, x i • (delta i - delta 0)) ∈ pathSpan n := by
    apply Submodule.sum_mem
    intro i _
    exact (pathSpan n).smul_mem (x i) (delta_sub_first_mem n i)
  have heq : (∑ i, x i • (delta i - delta 0)) = x := by
    ext j
    simp only [Finset.sum_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul, mul_sub,
      Finset.sum_sub_distrib]
    have hfirst : (∑ i, x i * delta i j) = x j := by
      simp [delta, Pi.single_apply]
    rw [hfirst, ← Finset.sum_mul, hx]
    simp
  rwa [heq] at hmem

theorem sum_eq_zero_of_mem_pathSpan (n : ℕ) (x : Fin (n+1) → F₂)
    (hx : x ∈ pathSpan n) : ∑ i, x i = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      rcases hx with ⟨i,rfl⟩
      simp [pathRoot,delta,Finset.sum_sub_distrib]
  | zero => simp
  | add x y hx hy ihx ihy => simp [Finset.sum_add_distrib, ihx, ihy]
  | smul a x hx ih => simp [← Finset.mul_sum, ih]

/-- The exact parity criterion for a whole norm-two path. -/
theorem mem_pathSpan_iff (n : ℕ) (x : Fin (n+1) → F₂) :
    x ∈ pathSpan n ↔ ∑ i, x i = 0 :=
  ⟨sum_eq_zero_of_mem_pathSpan n x, zero_sum_mem_pathSpan n x⟩

/-- A zero-sum linear combination of the vertices of a path belongs to
any submodule containing all its adjacent differences. -/
theorem zero_sum_weighted_mem {V : Type*} [AddCommGroup V] [Module F₂ V]
    (n : ℕ) (v : Fin n → V) (S : Submodule F₂ V)
    (hroot : ∀ i : Fin (n-1),
      v ⟨i.val, by have := i.isLt; omega⟩ -
        v ⟨i.val+1, by have := i.isLt; omega⟩ ∈ S)
    (a : Fin n → F₂) (ha : ∑ i, a i = 0) :
    (∑ i, a i • v i) ∈ S := by
  cases n with
  | zero => simp
  | succ n =>
      have hd : ∀ i : Fin (n+1), v i - v 0 ∈ S := by
        intro i
        induction i using Fin.induction with
        | zero => simp
        | succ i ih =>
            have hr : v i.castSucc - v i.succ ∈ S := hroot i
            have h := S.sub_mem ih hr
            convert h using 1
            abel
      have hmem : (∑ i, a i • (v i - v 0)) ∈ S := by
        apply Submodule.sum_mem
        intro i _
        exact S.smul_mem (a i) (hd i)
      have heq : (∑ i, a i • (v i - v 0)) = ∑ i, a i • v i := by
        simp_rw [smul_sub]
        rw [Finset.sum_sub_distrib, ← Finset.sum_smul, ha, zero_smul, sub_zero]
      rwa [heq] at hmem

open LatticeEmbedding

/-- The literal adjacent difference in each of the four coordinate blocks. -/
def standardRoot (m : ℕ) (r : RootIndex m) : Blocks m → F₂ :=
  Pi.single (leftEndpoint r) 1 - Pi.single (rightEndpoint r) 1

/-- The subspace generated by the standard norm-two roots. -/
def blockRootSpan (m : ℕ) : Submodule F₂ (Blocks m → F₂) :=
  Submodule.span F₂ (Set.range (standardRoot m))

/-- The four block sums and the singleton coordinate all vanish. -/
def zeroBlockSums {m : ℕ} (x : Blocks m → F₂) : Prop :=
  (∑ i : Fin m, x (.inl i)) = 0 ∧
  (∑ i : Fin 3, x (.inr (.inl i))) = 0 ∧
  (∑ i : Fin 2, x (.inr (.inr (.inl i)))) = 0 ∧
  (∑ i : Fin 2, x (.inr (.inr (.inr (.inl i))))) = 0 ∧
  x (.inr (.inr (.inr (.inr ())))) = 0

theorem zeroBlockSums_standardRoot (m : ℕ) (r : RootIndex m) :
    zeroBlockSums (standardRoot m r) := by
  rcases r with i | (i | i)
  · simp [zeroBlockSums, standardRoot, leftEndpoint, rightEndpoint,
      Pi.single_apply, Finset.sum_sub_distrib]
  · simp [zeroBlockSums, standardRoot, leftEndpoint, rightEndpoint,
      Pi.single_apply, Finset.sum_sub_distrib]
  · by_cases hi : i.val = 0 <;>
      simp [zeroBlockSums, standardRoot, leftEndpoint, rightEndpoint,
        hi, Pi.single_apply, Finset.sum_sub_distrib]

theorem zeroBlockSums_of_mem {m : ℕ} (x : Blocks m → F₂)
    (hx : x ∈ blockRootSpan m) : zeroBlockSums x := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      rcases hx with ⟨r, rfl⟩
      exact zeroBlockSums_standardRoot m r
  | zero => simp [zeroBlockSums]
  | add x y hx hy ihx ihy =>
      rcases ihx with ⟨hx₁, hx₂, hx₃, hx₄, hx₅⟩
      rcases ihy with ⟨hy₁, hy₂, hy₃, hy₄, hy₅⟩
      simp [zeroBlockSums, Finset.sum_add_distrib, hx₁, hx₂, hx₃, hx₄, hx₅,
        hy₁, hy₂, hy₃, hy₄, hy₅]
  | smul a x hx ih =>
      rcases ih with ⟨hx₁, hx₂, hx₃, hx₄, hx₅⟩
      simp [zeroBlockSums, ← Finset.mul_sum, hx₁, hx₂, hx₃, hx₄, hx₅]

theorem mem_of_zeroBlockSums {m : ℕ} (x : Blocks m → F₂)
    (hx : zeroBlockSums x) : x ∈ blockRootSpan m := by
  rcases hx with ⟨hx₁, hx₂, hx₃, hx₄, hx₅⟩
  have h₁ := zero_sum_weighted_mem m
    (fun i => (Pi.single (.inl i) 1 : Blocks m → F₂)) (blockRootSpan m)
    (fun i => (Submodule.subset_span ⟨.inl i, rfl⟩))
    (fun i => x (.inl i)) hx₁
  have h₂ := zero_sum_weighted_mem 3
    (fun i => (Pi.single (.inr (.inl i)) 1 : Blocks m → F₂)) (blockRootSpan m)
    (fun i => (Submodule.subset_span ⟨.inr (.inl i), rfl⟩))
    (fun i => x (.inr (.inl i))) hx₂
  have h₃ := zero_sum_weighted_mem 2
    (fun i => (Pi.single (.inr (.inr (.inl i))) 1 : Blocks m → F₂))
    (blockRootSpan m) (by
      intro i
      have hi : i = 0 := by
        apply Fin.ext
        have := i.isLt
        omega
      subst i
      exact Submodule.subset_span ⟨.inr (.inr 0), rfl⟩)
    (fun i => x (.inr (.inr (.inl i)))) hx₃
  have h₄ := zero_sum_weighted_mem 2
    (fun i => (Pi.single (.inr (.inr (.inr (.inl i)))) 1 : Blocks m → F₂))
    (blockRootSpan m) (by
      intro i
      have hi : i = 0 := by
        apply Fin.ext
        have := i.isLt
        omega
      subst i
      exact Submodule.subset_span ⟨.inr (.inr 1), rfl⟩)
    (fun i => x (.inr (.inr (.inr (.inl i))))) hx₄
  have hsum := (blockRootSpan m).add_mem
    ((blockRootSpan m).add_mem ((blockRootSpan m).add_mem h₁ h₂) h₃) h₄
  convert hsum using 1
  ext j
  rcases j with j | (j | (j | (j | j))) <;>
    simp [Finset.sum_apply, Pi.single_apply, hx₅]
  all_goals
    have hj : j = 0 ∨ j = 1 := by omega
    rcases hj with rfl | rfl <;> simp

/-- The span of the norm-two roots is exactly the subspace of vectors whose
four block sums and remaining singleton coordinate vanish. -/
theorem mem_blockRootSpan_iff {m : ℕ} (x : Blocks m → F₂) :
    x ∈ blockRootSpan m ↔ zeroBlockSums x :=
  ⟨zeroBlockSums_of_mem x, mem_of_zeroBlockSums x⟩

/-- Appending an independent vector to a family excludes membership in
that family's span. This uses the supplied linear independence directly. -/
theorem not_mem_span_of_option_independent {ι V : Type*}
    [AddCommMonoid V] [Module F₂ V] (x : V) (v : ι → V)
    (hi : LinearIndependent F₂ (fun r : Option ι =>
      match r with | none => x | some i => v i)) :
    x ∉ Submodule.span F₂ (Set.range v) := by
  intro hx
  apply hi.notMem_span none
  apply Submodule.span_mono ?_ hx
  rintro y ⟨i, rfl⟩
  exact ⟨some i, by simp, rfl⟩

/-- Integral coordinates of the heavy vertex `B` after the root blocks
have been put in standard form. -/
def bCoordinates (m : ℕ) (b g r s t : ℤ) : Blocks m → ℤ
  | .inl _ => b
  | .inr (.inl i) => if i.val = 0 then g-1 else g
  | .inr (.inr (.inl _)) => r
  | .inr (.inr (.inr (.inl _))) => s
  | .inr (.inr (.inr (.inr _))) => t

theorem intCast_modTwo_eq_zero_iff (a : ℤ) :
    (a : F₂) = 0 ↔ a % 2 = 0 := by
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd, Int.dvd_iff_emod_eq_zero]
  norm_num

/-- The two repeated-coordinate pairs vanish automatically modulo two.
The remaining three parity conditions characterize actual span membership. -/
theorem bCoordinates_mem_iff (m : ℕ) (b g r s t : ℤ) :
    (fun j => (bCoordinates m b g r s t j : F₂)) ∈ blockRootSpan m ↔
      ((m : ℤ)*b) % 2 = 0 ∧ (3*g-1) % 2 = 0 ∧ t % 2 = 0 := by
  have h₁ : (∑ i : Fin m, (bCoordinates m b g r s t (.inl i) : F₂)) =
      (((m : ℤ)*b : ℤ) : F₂) := by simp [bCoordinates]
  have h₂ : (∑ i : Fin 3, (bCoordinates m b g r s t (.inr (.inl i)) : F₂)) =
      ((3*g-1 : ℤ) : F₂) := by
    simp [bCoordinates, Fin.sum_univ_succ]
    ring
  have h₃ : (∑ i : Fin 2,
      (bCoordinates m b g r s t (.inr (.inr (.inl i))) : F₂)) = 0 := by
    simp only [bCoordinates, Fin.sum_univ_two]
    rw [← two_mul, show (2 : F₂) = 0 by decide, zero_mul]
  have h₄ : (∑ i : Fin 2,
      (bCoordinates m b g r s t (.inr (.inr (.inr (.inl i)))) : F₂)) = 0 := by
    simp only [bCoordinates, Fin.sum_univ_two]
    rw [← two_mul, show (2 : F₂) = 0 by decide, zero_mul]
  rw [mem_blockRootSpan_iff]
  unfold zeroBlockSums
  rw [h₁, h₂, h₃, h₄]
  simp only [bCoordinates, true_and, intCast_modTwo_eq_zero_iff]

/-- The integer parity hypothesis in `LatticeConfiguration` follows from
failure of span membership for the normalized heavy vertex. -/
theorem independentB_of_not_mem (m : ℕ) (b g r s t : ℤ)
    (hB : (fun j => (bCoordinates m b g r s t j : F₂)) ∉ blockRootSpan m) :
    ¬ (((m : ℤ)*b) % 2 = 0 ∧ (3*g-1) % 2 = 0 ∧ t % 2 = 0) := by
  exact fun h => hB ((bCoordinates_mem_iff m b g r s t).mpr h)

end Trefoil.LatticeParity
